// FIXTURE (not compiled): the RED proof for the slop custom rules in
// `.swiftlint.yml`. `Scripts/lint.sh` copies this file to
// `Sources/SelfTest/SlopRules.swift` in a scratch package root and lints it
// with the real configuration; the stage passes only when every rule fires
// exactly as counted below and nothing under "must NOT trip" fires.
//
// Expected: slop_print_leftover ×5, slop_empty_catch ×3, nothing else.
import Foundation

func mustTrip() {
    print("debug")
    NSLog("transcript: %@", text)
    if enabled { print("inline, not at line start") }
    run(); debugPrint(value)
    Swift.print("qualified")
    do { try run() } catch {}
    do { try run() } catch let error as NSError {
    }
    do { try await work() } catch is NotCancellationError {}
}

func mustNotTrip() {
    do { try run() } catch { logger.error("run failed: \(error)") }
    do { try run() } catch {
        // best effort: the cue is fire-and-forget, a failure must never delay key-up
    }
    do { try await work() } catch is CancellationError {}
    formatter.print(line)
    // a comment that mentions print("x") and catch {} changes nothing
    let text = "print(\"inside a string literal\")"
}
